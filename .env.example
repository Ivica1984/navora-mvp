# Copy to .env.local for local development. Never commit .env.local.
# Values for the LOCAL Supabase stack are printed by `supabase status`.
# Never point a development or CI build at the live legacy project (SR-05, SR-12).

# Server-side only (ADR-017): deliberately NOT prefixed with NEXT_PUBLIC_,
# so neither value is ever bundled into browser JavaScript.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Feature flag for legacy demo pages (/matching, /partners). Default off (ADR-006).
NEXT_PUBLIC_FEATURE_DEMO_PAGES=false

# Local test login (from supabase/seed.sql, local only):
#   coach.test@navora.test / navora-local-only
