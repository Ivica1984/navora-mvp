# Copy to .env.local for local development. Never commit .env.local.
# Values for the LOCAL Supabase stack are printed by `supabase start`.
# Never point a development or CI build at the live legacy project (SR-05).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Feature flag for legacy demo pages (/matching, /partners). Default off (ADR-006).
NEXT_PUBLIC_FEATURE_DEMO_PAGES=false
