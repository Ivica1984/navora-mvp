# Copy to .env.local for local development. Never commit .env.local.
# Values for the LOCAL Supabase stack are printed by `supabase status`.
# Never point a development or CI build at the live legacy project (SR-05, SR-12).

# Server-side only (ADR-017): deliberately NOT prefixed with NEXT_PUBLIC_,
# so neither value is ever bundled into browser JavaScript.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Feature flag for legacy demo pages (/matching, /partners). Default off (ADR-006).
NEXT_PUBLIC_FEATURE_DEMO_PAGES=false

# Local test login (from supabase/seed.sql, local only):
#   coach.test@navora.test / navora-local-only

# SIG2 (ADR-076): delivery outside the app. Server-side only, never committed with values.
# Missing values = nothing is sent (signals then reach Operations at once in the app).
# SUPABASE_SERVICE_ROLE_KEY=      # the sender's two database functions only (src/features/push/dispatch.ts)
# VAPID_PUBLIC_KEY=               # base64url, uncompressed P-256 point (65 bytes); shown to browsers
# VAPID_PRIVATE_KEY=              # base64url, 32 bytes; production secret set by the owner (D-2)
# VAPID_SUBJECT=mailto:betrieb@example.ch
# PUSH_DISPATCH_SECRET=           # >= 32 characters; the scheduler calls POST /api/push/dispatch every minute
# PUSH_TRANSPORT=test             # CI and e2e only: accept every send without network
